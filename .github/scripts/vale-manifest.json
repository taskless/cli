      "directory": "packages/vale-darwin-arm64",
      "os": "darwin",
      "cpu": "arm64",
      "asset": "vale_{version}_macOS_arm64.tar.gz",
      "archiveMember": "vale",
      "sha256": "a0e5f30986bc06db6700dac7f550f42880c74fe202113dae68035ed2030e5b4d"
    },
    {
