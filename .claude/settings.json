{
  "permissions": {
    "allow": [
      "Bash(cat:*)",
      "Bash(date:*)",
      "Bash(echo:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(sort:*)",
      "Bash(tail:*)",
      "Bash(tr:*)",
      "Bash(wc:*)",
      "Bash(xargs sed:*)",
      "Skill(commit)",
      "Skill(commit:*)",
      "WebFetch(domain:developers.cloudflare.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "Bash(pnpm:*)",
      "Bash(git:*)",
      "Bash(node --test:*)",
      "WebFetch(domain:api.reactrouter.com)",
      "WebFetch(domain:docs.taskless.io)",
      "Bash(git status -u)",
      "mcp__linear__*",
      "Bash(gh pr:*)",
      "Bash(node -e \"const d=JSON.parse\\(require\\('fs'\\).readFileSync\\(0,'utf8'\\)\\);console.log\\(JSON.stringify\\(Object.fromEntries\\(['high','medium','low','resolved','needs_attention'].map\\(k=>[k,d.summary[k]]\\)\\)\\)\\)\")",
      "Bash(find skills -name \"SKILL.md\" -exec grep -l \"optional\\\\|required\" {} \\\\;)",
      "Skill(pr-writer)",
      "Skill(pr-writer:*)",
      "WebSearch"
    ],
    "deny": [
      "AskUserQuestion*",
      "Bash(npx:*)",
      "Bash(pnpm dlx @taskless/cli*)",
      "Bash(openspec:*)"
    ],
    "additionalDirectories": ["openspec/*"]
  },
  "read": {
    "deny": [
      "**/*.key",
      "**/*.pem",
      "**/.aws/**",
      "**/.env*",
      "**/.secrets*",
      "**/.ssh/**",
      "**/credentials/**",
      "**/secrets/**"
    ]
  },
  "hooks": {
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.agents/skills/worktrees-pnpm/scripts/worktree-create.sh\"",
            "statusMessage": "Creating worktree"
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.agents/skills/worktrees-pnpm/scripts/worktree-remove.sh\""
          }
        ]
      }
    ]
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "includeCoAuthoredBy": false
}
