{
  "name": "@taskless/cli",
  "version": "0.13.3",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/taskless/cli.git",
    "directory": "packages/cli"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.public.json",
    "build:nightly": "TASKLESS_BUILD_TARGET=nightly vite build && tsc -p tsconfig.public.json",
    "build:self": "TASKLESS_BUILD_TARGET=self vite build",
    "corpus:manifests": "tsx scripts/print-corpus-manifests.ts",
    "generate:api": "pnpm generate:api:schema && pnpm generate:api:types",
    "generate:api:schema": "tsx scripts/fetch-api-schema.ts",
    "generate:api:types": "openapi-typescript src/generated/api-v2.schema.json -o src/generated/api-v2.d.ts",
    "generate:ast-grep-schema": "tsx scripts/fetch-ast-grep-schema.ts",
    "generate:report-schema": "tsx scripts/fetch-report-schema.ts",
    "generate:rule-hash-vectors": "tsx scripts/fetch-rule-hash-vectors.ts",
    "generate:vale-schema": "tsx scripts/generate-vale-schema.ts",
    "prebuild": "tsx scripts/fetch-rule-hash-vectors.ts",
    "reference": "tsx scripts/write-reference.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./prompts": {
      "types": "./dist/prompts/index.d.ts",
      "import": "./dist/prompts.js"
    },
    "./layout": {
      "types": "./dist/layout/index.d.ts",
      "import": "./dist/layout.js"
    },
    "./schemas": {
      "types": "./dist/schemas/index.d.ts",
      "import": "./dist/schemas.js"
    },
    "./node/runtimes": {
      "types": "./dist/node/runtimes/index.d.ts",
      "import": "./dist/node/runtimes.js"
    },
    "./reference.json": "./assets/reference.json"
  },
  "files": [
    "dist",
    "assets/reference.json"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "dependencies": {
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.51.0",
    "@clack/prompts": "^1.2.0",
    "@jedmao/ini-parser": "0.2.4",
    "@types/sprintf-js": "^1.1.4",
    "chalk": "^5.6.2",
    "citty": "^0.1.6",
    "jose": "^6.2.2",
    "jsonc-parser": "^3.3.1",
    "openapi-fetch": "^0.17.0",
    "openapi-typescript": "^7.13.0",
    "posthog-node": "^5.28.11",
    "prettier": "^3.8.1",
    "smol-toml": "^1.6.1",
    "sprintf-js": "^1.1.3",
    "typescript": "^5.7.2",
    "uqr": "^0.1.3",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.3",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "bin": {
    "taskless": "./dist/index.js"
  },
  "optionalDependencies": {
    "@ast-grep/cli-darwin-arm64": "0.51.0",
    "@ast-grep/cli-darwin-x64": "0.51.0",
    "@ast-grep/cli-linux-arm64-gnu": "0.51.0",
    "@ast-grep/cli-linux-x64-gnu": "0.51.0",
    "@ast-grep/cli-win32-arm64-msvc": "0.51.0",
    "@ast-grep/cli-win32-ia32-msvc": "0.51.0",
    "@ast-grep/cli-win32-x64-msvc": "0.51.0",
    "@taskless/vale-darwin-arm64": "3.24.0-20261005234241",
    "@taskless/vale-darwin-x64": "3.24.0-20261005234241",
    "@taskless/vale-linux-arm64": "3.24.0-20261005234241",
    "@taskless/vale-linux-x64": "3.24.0-20261005234241",
    "@taskless/vale-win32-arm64": "3.24.0-20261005234241",
    "@taskless/vale-win32-x64": "3.24.0-20261005234241"
  }
}
