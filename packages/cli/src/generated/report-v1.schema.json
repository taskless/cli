{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "producer": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "cli"
        },
        "cliVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": ["kind", "cliVersion"],
      "additionalProperties": false
    },
    "scope": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "const": "github"
            },
            "owner": {
              "type": "string",
              "maxLength": 39,
              "pattern": "^[\\dA-Za-z](?:[\\dA-Za-z]|-(?=[\\dA-Za-z]))*$"
            },
            "repo": {
              "type": "string",
              "maxLength": 100,
              "pattern": "^(?!\\.{1,2}$)[\\w.-]+$"
            },
            "url": {
              "type": "string",
              "maxLength": 200,
              "pattern": "^https:\\/\\/github\\.com\\/[\\dA-Za-z-]+\\/[\\w.-]+$"
            },
            "retention": {
              "type": "string",
              "enum": ["public", "private"]
            },
            "window": {
              "type": "object",
              "properties": {
                "from": {
                  "type": "string",
                  "format": "date",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                },
                "to": {
                  "type": "string",
                  "format": "date",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                }
              },
              "required": ["from", "to"],
              "additionalProperties": false
            }
          },
          "required": ["provider", "owner", "repo", "url", "window"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "const": "none"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "window": {
              "type": "object",
              "properties": {
                "from": {
                  "type": "string",
                  "format": "date",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                },
                "to": {
                  "type": "string",
                  "format": "date",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                }
              },
              "required": ["from", "to"],
              "additionalProperties": false
            }
          },
          "required": ["provider", "window"],
          "additionalProperties": false
        }
      ]
    },
    "history": {
      "type": "object",
      "properties": {
        "mergedPrs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        "reviewComments": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        "agentAssistedPrs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        "patterns": {
          "type": "object",
          "properties": {
            "ruleShaped": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000
            },
            "judgment": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000
            }
          },
          "required": ["ruleShaped", "judgment"],
          "additionalProperties": false
        }
      },
      "required": [
        "mergedPrs",
        "reviewComments",
        "agentAssistedPrs",
        "patterns"
      ],
      "additionalProperties": false
    },
    "rules": {
      "minItems": 1,
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[\\dA-Za-z][\\w.-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "tier": {
            "type": "string",
            "enum": ["cli", "cloud", "legacy"]
          },
          "engine": {
            "type": "string",
            "enum": ["sg", "vale", "runtime"]
          },
          "tool": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[\\w@./+-]+$"
          },
          "language": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "origin": {
            "type": "object",
            "properties": {
              "reviewComments": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000000
              },
              "prs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000000
              }
            },
            "required": ["reviewComments", "prs"],
            "additionalProperties": false
          },
          "fixed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000
          },
          "fixedBasis": {
            "type": "string",
            "enum": ["measured", "estimated"]
          },
          "complexity": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 100
              },
              {
                "type": "null"
              }
            ]
          },
          "tests": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": ["pass", "fail", "refused", "not-run"]
              },
              "fail": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "code": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4000
                      }
                    },
                    "required": ["code"],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "pass": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "code": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4000
                      }
                    },
                    "required": ["code"],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "withheld": {
                "maxItems": 2,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": ["fail", "pass"]
                }
              }
            },
            "required": ["status", "fail", "pass", "withheld"],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "title",
          "tier",
          "language",
          "fixed",
          "fixedBasis",
          "complexity",
          "tests"
        ],
        "additionalProperties": false
      }
    },
    "projection": {
      "type": "object",
      "properties": {
        "perMonth": {
          "type": "object",
          "properties": {
            "commentsPrevented": {
              "type": "object",
              "properties": {
                "cli": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000
                },
                "cloud": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000
                },
                "legacy": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000
                }
              },
              "required": ["cli", "cloud"],
              "additionalProperties": false
            },
            "agentCatches": {
              "type": "object",
              "properties": {
                "cli": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000
                },
                "cloud": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000
                },
                "legacy": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000
                }
              },
              "required": ["cli", "cloud"],
              "additionalProperties": false
            }
          },
          "required": ["agentCatches"],
          "additionalProperties": false
        },
        "inputs": {
          "type": "object",
          "properties": {
            "contextTokens": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 10000000
            },
            "callsPerCatch": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1000
            },
            "cloudComplexity": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 100
            },
            "pricePerMillionTokens": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000
            },
            "minutesPerComment": {
              "type": "number",
              "minimum": 0,
              "maximum": 600
            },
            "reviewerHourlyUsd": {
              "type": "number",
              "minimum": 0,
              "maximum": 10000
            }
          },
          "required": [
            "contextTokens",
            "callsPerCatch",
            "cloudComplexity",
            "pricePerMillionTokens",
            "minutesPerComment",
            "reviewerHourlyUsd"
          ],
          "additionalProperties": false
        }
      },
      "required": ["perMonth", "inputs"],
      "additionalProperties": false
    },
    "redaction": {
      "type": "object",
      "properties": {
        "policyVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16
        },
        "counts": {
          "type": "object",
          "properties": {
            "secret": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000
            },
            "email": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000
            },
            "person": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000
            },
            "customer": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000
            },
            "host": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000
            },
            "ip": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000
            },
            "phone": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000
            },
            "text": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000
            }
          },
          "required": [
            "secret",
            "email",
            "person",
            "customer",
            "host",
            "ip",
            "phone",
            "text"
          ],
          "additionalProperties": false
        },
        "withheldFixtures": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        }
      },
      "required": ["policyVersion", "counts", "withheldFixtures"],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "generatedAt",
    "producer",
    "scope",
    "rules",
    "projection",
    "redaction"
  ],
  "additionalProperties": false,
  "$id": "https://tskl.es/api/v1/schema",
  "title": "ReportV1",
  "description": "A Taskless Report, as a CLI publishes it to tskl.es. Every object rejects unknown keys.",
  "examples": [
