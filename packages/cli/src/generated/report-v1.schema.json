  "x-taskless": {
    "publish": {
      "method": "POST",
      "url": "https://tskl.es/api/v1/reports",
      "maxBytes": 262144,
      "rateLimitPerIp": {
        "limit": 10,
        "periodSeconds": 60
      },
      "response": {
        "status": 201,
        "body": {
          "url": "The report on tskl.es. Anyone with it can view it.",
          "deleteUrl": "The only way to delete the report before it expires. Returned once, here.",
          "expiresAt": "30 days after publishing, or 183 for public retention."
        }
      },
      "errors": {
        "validation_error": {
          "status": 400,
          "description": "The body is not JSON, fails the schema, or fails a consistency check; `details` names each failure. Not retryable as sent."
        },
        "payload_too_large": {
          "status": 413,
          "description": "The body is larger than `maxBytes`, by its declared length or the bytes read. Refused before parsing."
        },
        "rate_limited": {
          "status": 429,
          "description": "Too many publishes from this address. Retry after a minute."
        },
        "publish_failed": {
          "status": 502,
          "description": "The report was valid but could not be rendered or stored. Nothing was published: retry. Retry only on this error, never after a timeout, which may still publish."
        }
      }
    }
  }
}
