# OS
.DS_Store

# Dependencies
node_modules/

# Build output (prod, dev, and self targets each emit to their own directory)
**/dist/
**/dist-dev/
**/dist-self/
*.tsbuildinfo
.turbo/

# Secrets
.dev.vars

# Claude Code (user-specific)
.claude/projects/
.claude/worktrees/
.claude/settings.local.json
.mcp.json

# Local Taskless self-install (generated by `pnpm build:self`; never committed)
/.taskless/skills/
/.taskless/commands/
/.claude/skills/taskless/
/.claude/commands/tskl/

# Vale platform-package tarballs (npm pack output from vale-prepare.cjs)
.vale-dist/

# Nightly CLI tarball + the changeset status file it reads (nightly-pack.cjs).
# `changeset status --output=` resolves against the working directory, so this
# lands at the repo root by design; an absolute path would not work.
.nightly-dist/
nightly-status.json

# Misc
tmp
# Auto-generated by dotagents — do not commit these files.
agents.lock
.agents/.gitignore

# Python bytecode (skill scripts)
__pycache__/
*.pyc

# Agent and manual git worktrees (full second checkouts; see worktrees-pnpm skill)
worktrees/
